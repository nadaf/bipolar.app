<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="bootstrap.php" colors="true" cacheDirectory="tmp/.phpunit.cache"
         failOnWarning="true" failOnRisky="true" executionOrder="default">
  <testsuites>
    <testsuite name="unit"><directory>Unit</directory></testsuite>
    <testsuite name="integration"><directory>Integration</directory></testsuite>
  </testsuites>
</phpunit>
