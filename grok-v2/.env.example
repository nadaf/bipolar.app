# Copie para .env e preencha. NUNCA envie o .env para o GitHub.
APP_NAME="Bipolar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bipolar.app.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=UTC

# Codigo do instalador web (/instalar). Use 40+ caracteres aleatorios. APAGUE depois de instalar.
INSTALLER_TOKEN=

BIPOLAR_EDITION=community

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Banco do Bipolar 0.5 (so leitura) para /migrar-dados. Deixe vazio; apague depois de importar.
OLD_DB_HOST=
OLD_DB_DATABASE=
OLD_DB_USERNAME=
OLD_DB_PASSWORD=
# So se a APP_KEY mudou depois de copiar: a APP_KEY antiga (base64:...). Usada so para consertar.
OLD_APP_KEY=
# e-mails (separados por virgula) cuja conta do 2.0 ja existia: junta os dados da 0.5 nela
OLD_JUNTAR_CONTAS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Subdominios <slug>.bipolar.app.br (opcional). Nao use SESSION_DOMAIN: sessao e por host.
BIPOLAR_BASE_DOMAIN=bipolar.app.br
BIPOLAR_MAIN_HOSTS=

# Web Push (lembretes). Gere com: php artisan bipolar:vapid  (nunca versione a chave privada)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Atualizacao automatica (cron do cPanel, ver cron.txt). false = desligado.
AUTO_UPDATE_ENABLED=true
# true = instala tambem versoes beta (pre-release). false = so versoes finais.
AUTO_UPDATE_PRERELEASE=true
